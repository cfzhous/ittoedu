{
  "schemaVersion": 4,
  "runtimeApiVersion": 4,
  "supportedScopes": [
    "scene"
  ],
  "renderMode": "phaser",
  "id": "com.example.render-host-phaser-meter",
  "name": "V4 Phaser 交互仪表",
  "version": "4.0.0",
  "description": "用于验证 Component API 4 的 Phaser 渲染面、交互与属性更新",
  "entry": "runtime.js",
  "thumbnail": "thumbnail.svg",
  "defaultSize": {
    "width": 720,
    "height": 390
  },
  "minSize": {
    "width": 360,
    "height": 220
  },
  "preserveAspectRatio": true,
  "assets": {},
  "defaultProps": {
    "content": {
      "title": "V4 Phaser 交互仪表",
      "instruction": "点击仪表盘，验证当前 Phaser 组件渲染面与更新能力。",
      "readyStatus": "Component API 4 实例已就绪",
      "activatedStatusTemplate": "第 {count} 次交互：Phaser 渲染面正常",
      "centerLabel": "V4"
    },
    "accent": "#f59e0b",
    "background": "#1e1b4b"
  },
  "editor": {
    "properties": [
      {
        "key": "content.title",
        "label": "仪表标题",
        "type": "text",
        "maxLength": 60
      },
      {
        "key": "content.instruction",
        "label": "操作说明",
        "type": "textarea",
        "maxLength": 160
      },
      {
        "key": "content.centerLabel",
        "label": "中心标识",
        "type": "text",
        "maxLength": 12
      },
      {
        "key": "accent",
        "label": "强调色",
        "type": "color"
      },
      {
        "key": "background",
        "label": "背景色",
        "type": "color"
      }
    ]
  }
}
