{
  "schemaVersion": 4,
  "runtimeApiVersion": 4,
  "renderMode": "dom",
  "supportedScopes": [
    "scene"
  ],
  "id": "com.alepha.physics.incline-motion-3d",
  "name": "3D 斜面运动实验",
  "version": "1.0.0",
  "description": "调节斜面倾角与摩擦系数，观察滑块运动并记录两组对照数据",
  "entry": "runtime.js",
  "thumbnail": "thumbnail.svg",
  "defaultSize": {
    "width": 1140,
    "height": 450
  },
  "minSize": {
    "width": 760,
    "height": 360
  },
  "preserveAspectRatio": false,
  "assets": {},
  "defaultProps": {
    "content": {
      "ariaLabel": "斜面运动三维互动实验",
      "canvasLabel": "可拖动旋转视角的三维斜面实验",
      "eyebrow": "3D PHYSICS LAB",
      "title": "斜面运动实验台",
      "instruction": "改变倾角或摩擦系数，释放滑块并记录两组不同的数据。",
      "angleLabel": "斜面倾角",
      "frictionLabel": "摩擦系数",
      "forceToggleLabel": "显示受力箭头",
      "releaseLabel": "释放滑块",
      "resetLabel": "复位位置",
      "recordLabel": "记录数据",
      "recordsTitle": "对照记录",
      "recordEmpty": "尚未记录",
      "recordTemplate": "{index}. {angle}° · μ={friction} · a={acceleration} m/s² · t={time}s",
      "accelerationLabel": "加速度",
      "timeLabel": "到达时间",
      "readyStatus": "调整参数后，点击“释放滑块”",
      "runningStatus": "滑块正在沿斜面运动",
      "stuckStatus": "摩擦作用足够大，滑块保持静止",
      "completedStatus": "实验完成，可以记录本组数据",
      "recordedStatus": "已记录第 {count} 组数据",
      "duplicateStatus": "请先改变倾角或摩擦系数，再记录一组对照数据",
      "comparisonStatus": "两组对照实验完成，规律归纳已解锁",
      "editStatus": "编辑预览：参数与文案可在属性面板修改",
      "captureStatus": "静态实验画面",
      "suspendedStatus": "三维实验已暂停",
      "legendGravity": "重力",
      "legendNormal": "支持力",
      "legendFriction": "摩擦力",
      "legendComponent": "沿斜面分力"
    },
    "initialAngle": 24,
    "initialFriction": 0.12,
    "gravity": 9.8,
    "trackLength": 7.2,
    "showForceArrows": true,
    "accent": "#38bdf8",
    "blockColor": "#fb923c",
    "surface": "#071827"
  },
  "editor": {
    "properties": [
      {
        "key": "content.title",
        "label": "实验标题",
        "type": "text",
        "maxLength": 60
      },
      {
        "key": "content.instruction",
        "label": "实验说明",
        "type": "textarea",
        "maxLength": 180
      },
      {
        "key": "content.releaseLabel",
        "label": "释放按钮",
        "type": "text",
        "maxLength": 24
      },
      {
        "key": "content.resetLabel",
        "label": "复位按钮",
        "type": "text",
        "maxLength": 24
      },
      {
        "key": "content.recordLabel",
        "label": "记录按钮",
        "type": "text",
        "maxLength": 24
      },
      {
        "key": "initialAngle",
        "label": "默认倾角",
        "type": "number",
        "min": 10,
        "max": 45,
        "step": 1
      },
      {
        "key": "initialFriction",
        "label": "默认摩擦系数",
        "type": "number",
        "min": 0,
        "max": 0.5,
        "step": 0.01
      },
      {
        "key": "gravity",
        "label": "重力加速度",
        "type": "number",
        "min": 1,
        "max": 20,
        "step": 0.1
      },
      {
        "key": "showForceArrows",
        "label": "默认显示受力箭头",
        "type": "boolean"
      },
      {
        "key": "accent",
        "label": "强调色",
        "type": "color"
      },
      {
        "key": "blockColor",
        "label": "滑块颜色",
        "type": "color"
      },
      {
        "key": "surface",
        "label": "实验台底色",
        "type": "color"
      }
    ]
  }
}
