{
  "schemaVersion": 3,
  "runtimeApiVersion": 3,
  "supportedScopes": [
    "global"
  ],
  "id": "com.example.runtime-v3-global-controls",
  "name": "V3 全局课程控制条",
  "version": "3.0.0",
  "description": "跨场景持续存在的上一页、重播、下一页与重开控制条",
  "entry": "runtime.js",
  "defaultSize": {
    "width": 1060,
    "height": 78
  },
  "minSize": {
    "width": 620,
    "height": 64
  },
  "preserveAspectRatio": false,
  "assets": {},
  "defaultProps": {
    "content": {
      "title": "全局课程控制",
      "buttons": {
        "previous": "上一页",
        "replay": "重播本页",
        "next": "下一页",
        "restart": "重开课程"
      },
      "status": {
        "ready": "全局组件已就绪，普通翻页不会重建",
        "sceneChanged": "当前场景：{scene} · 已操作 {count} 次",
        "previous": "已请求上一页 · 累计操作 {count} 次",
        "replay": "已重播当前场景，全局控制条未重建 · {count} 次",
        "next": "已请求下一页 · 累计操作 {count} 次",
        "restart": "正在重开整门课程 · 本轮操作 {count} 次"
      },
      "sceneNames": {
        "scene_intro": "01 认识 V3",
        "scene_challenge": "02 场景互动",
        "scene_summary": "03 课程小结"
      }
    },
    "accent": "#38bdf8",
    "background": "#0f172a",
    "buttonBackground": "#1e293b",
    "enabled": true
  },
  "editor": {
    "properties": [
      {
        "key": "content.title",
        "label": "控制条标题",
        "description": "组件左侧标题",
        "type": "text",
        "maxLength": 40
      },
      {
        "key": "content.buttons.previous",
        "label": "上一页按钮",
        "type": "text",
        "maxLength": 20
      },
      {
        "key": "content.buttons.replay",
        "label": "重播按钮",
        "type": "text",
        "maxLength": 20
      },
      {
        "key": "content.buttons.next",
        "label": "下一页按钮",
        "type": "text",
        "maxLength": 20
      },
      {
        "key": "content.buttons.restart",
        "label": "重开按钮",
        "type": "text",
        "maxLength": 20
      },
      {
        "key": "content.status.sceneChanged",
        "label": "场景状态格式",
        "description": "支持 {scene} 和 {count} 占位符",
        "type": "text",
        "maxLength": 100
      },
      {
        "key": "accent",
        "label": "强调色",
        "type": "color"
      },
      {
        "key": "background",
        "label": "背景色",
        "type": "color"
      },
      {
        "key": "buttonBackground",
        "label": "按钮底色",
        "type": "color"
      },
      {
        "key": "enabled",
        "label": "允许操作",
        "type": "boolean"
      }
    ]
  }
}
