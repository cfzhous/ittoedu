{
  "schemaVersion": 4,
  "runtimeApiVersion": 4,
  "renderMode": "dom",
  "supportedScopes": [
    "scene"
  ],
  "id": "com.alepha.math.motion-function-lab",
  "name": "动点问题·五步建模课",
  "version": "0.2.0",
  "description": "课程专用的预测、约束、建模、图式联动、定义域修复、迁移与总结互动",
  "entry": "runtime.js",
  "thumbnail": "thumbnail.png",
  "defaultSize": {
    "width": 1140,
    "height": 452
  },
  "minSize": {
    "width": 820,
    "height": 380
  },
  "preserveAspectRatio": false,
  "assets": {},
  "defaultProps": {
    "mode": "linked-graph",
