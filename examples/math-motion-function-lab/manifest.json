      "provedStatus": "位置、表达式与图象给出同一结论：Smax = 6，t = 2",
      "disabledHint": "编辑或静态捕获中保留确定画面，请在试运行中操作",
      "suspendedHint": "联动实验已暂停",
      "pointA": "A",
      "pointB": "B",
      "pointC": "C",
      "pointD": "D",
      "pointP": "P",
      "pointQ": "Q",
      "maximumLabel": "Smax = 6"
    },
    "palette": {
      "paper": "#FBF8F1",
      "ink": "#16191F",
      "muted": "#74777C",
      "line": "#C9CDD2",
      "blue": "#145DCE",
      "blueSoft": "#DCE9FF",
      "red": "#E04424",
      "redSoft": "#F8D9CF",
      "focus": "#0A53BE"
    },
    "reducedMotion": false
  },
  "editor": {
    "properties": [
      {
        "key": "mode",
        "label": "互动模式",
        "type": "select",
        "options": [
          {
            "label": "预测",
            "value": "prediction"
          },
          {
            "label": "约束分类",
            "value": "constraints"
          },
          {
            "label": "函数建模",
            "value": "model"
          },
          {
            "label": "图式联动",
            "value": "linked-graph"
          },
          {
            "label": "定义域修复",
            "value": "domain"
          },
          {
            "label": "同构迁移",
            "value": "transfer"
          },
          {
            "label": "方法总结",
            "value": "summary"
          }
        ]
      },
      {
        "key": "content.dragInstruction",
        "label": "操作指令",
        "type": "textarea",
        "maxLength": 100
      },
      {
        "key": "content.confirmLabel",
        "label": "确认按钮",
        "type": "text",
        "maxLength": 30
      },
      {
        "key": "content.provedStatus",
        "label": "完成反馈",
        "type": "textarea",
        "maxLength": 120
      },
      {
        "key": "palette.paper",
        "label": "纸面色",
        "type": "color"
      },
      {
        "key": "palette.blue",
        "label": "变量蓝",
        "type": "color"
      },
      {
        "key": "palette.red",
        "label": "目标量红",
        "type": "color"
      },
      {
        "key": "reducedMotion",
        "label": "强制减少动效",
        "type": "boolean"
      }
    ]
  }
