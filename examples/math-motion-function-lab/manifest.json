      "graphHeading": "面积函数",
      "areaRegionLabel": "目标面积 △APQ",
      "timeLabel": "时间 t",
      "areaLabel": "面积 S(t)",
      "apLabel": "AP",
      "bqLabel": "BQ",
      "domainLabel": "运动范围",
      "dragInstruction": "拖动 t，依次检查 0、2、4 三个关键时刻",
