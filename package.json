{
  "name": "ittoedu-courseware-editor",
  "version": "1.0.0",
  "description": "专业互动课件编辑器",
  "main": "dist-electron/main/index.js",
  "author": "ittoedu",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "install:courseware-skills": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-courseware-skills.ps1",
    "prestart": "npm run install:courseware-skills",
    "predev": "npm run build:player && npm run build:electron",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run && npm run test:agent-kit",
    "test:agent-kit": "node --test agent-kit/tests/agent-kit.test.mjs",
    "test:protocol": "vitest run tests/unit/courseProjectProtocol.test.ts tests/unit/coursePublishPipeline.test.ts tests/unit/currentDynamicExecution.test.ts tests/unit/componentProtocolV4.test.ts tests/unit/surfaceRuntimeV1.test.ts",
    "prepare:e2e": "npm run build:course-cases && npm run build:renderer && npm run build:electron",
    "pretest:e2e": "npm run prepare:e2e",
    "test:e2e": "playwright test tests/e2e/course-studio.spec.ts",
    "test:e2e:run": "playwright test tests/e2e/course-studio.spec.ts",
    "test:e2e:visible": "cross-env COURSEWARE_E2E_BACKGROUND=0 npm run test:e2e",
    "build:player": "vite build --config vite.player.config.ts",
    "build:course-cases": "npm run build:player && tsx scripts/build-course-cases.ts",
    "verify:course-cases": "tsx scripts/build-course-cases.ts --verify-only",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build:player && npm run build:renderer && npm run build:electron",
    "start": "npm run build:desktop && electron .",
    "generate:ai-capabilities": "tsx scripts/generate-ai-capabilities.ts",
    "check:ai-capabilities": "tsx scripts/generate-ai-capabilities.ts --check",
    "validate:project": "tsx scripts/validate-project.ts",
    "validate:course": "node agent-kit/bin/courseware-agent-kit.mjs validate --course",
    "current:course-selection": "tsx scripts/read-course-selection.ts",
    "prepatch:course-project": "npm run build:player",
    "patch:course-project": "tsx scripts/patch-course-project.ts",
    "build": "npm run check:ai-capabilities && npm run typecheck && npm run test && npm run build:desktop",
    "dist:win": "npm run build && electron-builder --win portable dir --x64",
    "verify": "npm run build",
    "verify:full": "npm run check:ai-capabilities && npm run typecheck && npm run test && npm run prepare:e2e && npm run test:e2e:run",
    "verify:clean-windows": "tsx scripts/verify-clean-windows.ts",
    "build:icons": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.3",
    "immer": "11.1.15",
    "lucide-react": "1.25.0",
    "nanoid": "6.0.0",
    "phaser": "4.2.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  }
}
