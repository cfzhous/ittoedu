{
  "name": "phaser-courseware-editor",
  "version": "1.0.0",
  "description": "专业互动课件编辑器",
  "main": "dist-electron/main/index.js",
  "author": "Alepha",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "install:courseware-skills": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-courseware-skills.ps1",
    "prestart": "npm run install:courseware-skills",
    "predev": "npm run build:player && npm run build:electron",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run build:player && npm run build:examples && npm run build:lesson-demo:fixture && npm run build:render-benchmark:fixture && npm run build:renderer && npm run build:electron",
    "test:e2e": "playwright test",
    "build:player": "vite build --config vite.player.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build:player && npm run build:renderer && npm run build:electron",
    "start": "npm run build:desktop && electron .",
    "build": "npm run typecheck && npm run test && npm run build:desktop",
    "dist:win": "npm run build && electron-builder --win portable dir --x64",
    "verify": "npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "build:examples": "tsx scripts/build-examples.ts",
    "build:lesson-demo": "npm run build:player && npm run build:lesson-demo:fixture",
    "build:lesson-demo:fixture": "tsx scripts/build-interactive-lesson.ts",
    "build:induction": "tsx scripts/build-induction-lesson.ts",
    "validate:induction": "tsx scripts/validate-induction-lesson.ts",
    "build:math-motion-sample": "npm run build:player && tsx scripts/build-math-motion-sample.ts",
    "validate:math-motion-sample": "tsx scripts/validate-math-motion-sample.ts",
    "build:math-motion-course": "npm run build:player && tsx scripts/build-math-motion-course.ts",
    "export:math-motion-course": "tsx scripts/export-math-motion-static.ts && C:\\Users\\74755\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\python\\python.exe scripts/export_math_motion_pdf.py",
    "finalize:math-motion-course": "tsx scripts/finalize-math-motion-evidence.ts",
    "validate:math-motion-static": "tsx scripts/validate-math-motion-static.ts",
    "validate:math-motion-course": "tsx scripts/validate-math-motion-course.ts",
    "build:render-benchmark": "npm run build:player && npm run build:render-benchmark:fixture",
    "build:render-benchmark:fixture": "tsx scripts/build-render-host-benchmark.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "verify:release": "npm run verify && tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "fflate": "0.8.3",
    "immer": "11.1.15",
    "lucide-react": "1.25.0",
    "nanoid": "6.0.0",
    "phaser": "4.2.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "three": "0.185.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  }
}
