    "source": "CoursewareRuntime.define({runtimeApiVersion:2,authoringApiVersion:1,create(ctx){const root=ctx.dom.overlay;const render=(kind)=>{root.dataset.outcome=kind;root.textContent=ctx.content.get(kind==='success'?'successMessage':kind==='error'?'errorMessage':'hiddenMessage')};render('hidden');const dispose=ctx.authoring?.register({kind:'text',key:'prompt',label:'实验提示',getBounds:()=>({x:80,y:120,width:420,height:64})});return{resize(){},setVisible(value){root.hidden=!value},suspend(){},resume(){},prepareCapture(){render('success')},destroy(){dispose?.();root.replaceChildren()}}}})"
  },
